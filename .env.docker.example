# Copy this file to .env.local and fill in values before starting the Compose service.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
OPENROUTER_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
NOTIFICATION_EMAIL=

# Optional Docker Compose interpolation settings; pass this file with --env-file.
APP_PORT=3000
IMAGE_TAG=latest
